<?xml version="1.0"?>
<xacro xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="PI" value="3.1415927"/>

  <xacro:macro name="apriltag_panel" params="ns panel_name:=side *origin">
    <link name="${ns}/apriltag_panel_${panel_name}">
      <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0000375" ixy="0" ixz="0" iyy="0.0000375" iyz="0" izz="0.00007500"/>
      </inertial>
      
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.1 0.1 0.001"/>
        </geometry>

        <material name="apriltag">
          <texture filename="package://bluerov2_description/materials/textures/tag41_12_00000.png"/>
          <color rgba="1 1 1 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.1 0.1 0.001"/>
        </geometry>
      </collision>
    </link>

    <joint name="${ns}/apriltag_panel_${panel_name}_joint" type="fixed">
      <parent link="${ns}/base_link"/>
      <child link="${ns}/apriltag_panel_${panel_name}"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Add Gazebo-specific material configuration -->
    <gazebo reference="${ns}/apriltag_panel_${panel_name}">
      <visual>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>package://bluerov2_description/materials/textures/tag41_12_00000.png</albedo_map>
              <roughness>0.8</roughness>
              <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </gazebo>
  </xacro:macro>
</xacro>
